// Beveiligingsregels voor de suggesties (Firebase console > Firestore Database > Regels).
// Vervang BEHEERDER_EMAIL door het Google-account van de beheerder (alleen in de Firebase console, niet hier).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /suggesties/{id} {
      // iedereen mag een nieuwe suggestie insturen, alleen met deze velden en binnen de maximale lengte
      allow create: if request.resource.data.keys().hasOnly(['oefening','soort','tekst','naam','status','tijd'])
        && request.resource.data.status == 'nieuw'
        && request.resource.data.oefening is string && request.resource.data.oefening.size() <= 200
        && request.resource.data.soort is string && request.resource.data.soort.size() <= 40
        && request.resource.data.tekst is string && request.resource.data.tekst.size() > 0 && request.resource.data.tekst.size() <= 2000
        && request.resource.data.naam is string && request.resource.data.naam.size() <= 80
        && request.resource.data.tijd is timestamp
        && request.resource.data.tijd > request.time - duration.value(1, 'h')
        && request.resource.data.tijd < request.time + duration.value(1, 'h');
      // suggesties in behandeling zijn leesbaar zonder inloggen, zodat Claude ze kan uitwerken:
      // goedgekeurd (voorstel maken), aanpassen (voorstel bijwerken met de opmerking), live (live zetten)
      allow read: if resource.data.status in ['goedgekeurd', 'aanpassen', 'live'];
      // lezen, goedkeuren/afwijzen en verwijderen: alleen de beheerder
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true;
    }
    // bewaarde trainingen van een trainer (account.js): elke trainer met een Google-account heeft één eigen
    // document (document-id = zijn Firebase-uid). Alleen hij zelf mag het lezen, wijzigen of wissen,
    // met alleen de velden minis en senioren (tekst, max 100.000 tekens), teams (favoriete teams, max 2.000) en tijd.
    // Andere trainers zien niets.
    match /trainersopslag/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['minis','senioren','teams','tijd'])
        && request.resource.data.minis is string && request.resource.data.minis.size() <= 100000
        && request.resource.data.senioren is string && request.resource.data.senioren.size() <= 100000
        && (!('teams' in request.resource.data) || (request.resource.data.teams is string && request.resource.data.teams.size() <= 2000))
        && request.resource.data.tijd is timestamp;
    }
    // aanvalscombinaties van de beheerder (tabblad Aanval): alleen de beheerder, alleen zijn eigen document
    // (document-id = zijn Firebase-uid), met alleen de velden lijst (tekst, max 50.000 tekens) en tijd
    match /aanvalcombis/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['lijst','tijd'])
        && request.resource.data.lijst is string && request.resource.data.lijst.size() <= 50000
        && request.resource.data.tijd is timestamp;
    }
    // puntenverloop van live wedstrijden (homepagina): iedereen mag een stand toevoegen en alles lezen,
    // nooit wijzigen of verwijderen. Document-id = wedstrijd-id (/ wordt _) + _set_a_b, zodat elke stand maar één keer bestaat.
    match /liveverloop/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['w','s','a','b','t'])
        && request.resource.data.w is string && request.resource.data.w.size() <= 200
        && request.resource.data.w.matches('/competitie/wedstrijden/[A-Za-z0-9/_-]+')
        && request.resource.data.s is int && request.resource.data.s >= 0 && request.resource.data.s <= 4
        && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a <= 60
        && request.resource.data.b is int && request.resource.data.b >= 0 && request.resource.data.b <= 60
        && request.resource.data.t is timestamp
        && request.resource.data.t > request.time - duration.value(10, 'm')
        && request.resource.data.t < request.time + duration.value(10, 'm')
        && id == request.resource.data.w.replace('/', '_') + '_' + string(request.resource.data.s) + '_' + string(request.resource.data.a) + '_' + string(request.resource.data.b);
    }
  }
}
