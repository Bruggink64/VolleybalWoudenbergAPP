// Beveiligingsregels voor de suggesties (Firebase console > Firestore Database > Regels).
// Vervang BEHEERDER_EMAIL door het Google-account van de beheerder (alleen in de Firebase console, niet hier).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /suggesties/{id} {
      // iedereen mag een nieuwe suggestie insturen, alleen met deze velden en binnen de maximale lengte
      allow create: if request.resource.data.keys().hasOnly(['oefening','soort','tekst','naam','status','tijd'])
        && request.resource.data.status == 'nieuw'
        && request.resource.data.oefening is string && request.resource.data.oefening.size() <= 200
        && request.resource.data.soort is string && request.resource.data.soort.size() <= 40
        && request.resource.data.tekst is string && request.resource.data.tekst.size() > 0 && request.resource.data.tekst.size() <= 2000
        && request.resource.data.naam is string && request.resource.data.naam.size() <= 80
        && request.resource.data.tijd is timestamp
        && request.resource.data.tijd > request.time - duration.value(1, 'h')
        && request.resource.data.tijd < request.time + duration.value(1, 'h');
      // suggesties in behandeling zijn leesbaar zonder inloggen, zodat Claude ze kan uitwerken:
      // goedgekeurd (voorstel maken), aanpassen (voorstel bijwerken met de opmerking), live (live zetten)
      allow read: if resource.data.status in ['goedgekeurd', 'aanpassen', 'live'];
      // lezen, goedkeuren/afwijzen en verwijderen: alleen de beheerder
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true;
    }
    // aanvalscombinaties van de beheerder (tabblad Aanval): alleen de beheerder, alleen zijn eigen document
    // (document-id = zijn Firebase-uid), met alleen de velden lijst (tekst, max 50.000 tekens) en tijd
    match /aanvalcombis/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'BEHEERDER_EMAIL' && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['lijst','tijd'])
        && request.resource.data.lijst is string && request.resource.data.lijst.size() <= 50000
        && request.resource.data.tijd is timestamp;
    }
  }
}
